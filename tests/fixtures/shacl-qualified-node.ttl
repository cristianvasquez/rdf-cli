# From rdf-ext/shacl-engine PR #90 (test/assets/misc/qualifiedValueShape-node.ttl): shapes and data in one graph.
@prefix ex: <http://example.org/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.


ex:BedroomB a ex:Bedroom.

ex:citizen-a a ex:Citizen;
  ex:owns ex:HouseA.

ex:citizen-b a ex:Citizen;
  ex:owns ex:HouseB.

ex:citizenOwnsShape
  sh:node ex:houseShape;
  sh:path ex:owns.

ex:citizenShape a sh:NodeShape;
  sh:property ex:citizenOwnsShape;
  sh:targetClass ex:Citizen.

ex:HouseA a ex:House;
  ex:room ex:KitchenA.

ex:HouseB a ex:House;
  ex:room ex:BedroomB.

ex:houseKitchenShape
  sh:path ex:room;
  sh:qualifiedMinCount 1;
  sh:qualifiedValueShape [
      sh:class ex:Kitchen
    ].

ex:houseShape a sh:NodeShape;
  sh:property ex:houseKitchenShape.

ex:KitchenA a ex:Kitchen.
